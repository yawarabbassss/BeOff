# BeOff Environment Configuration Template
# DO NOT COMMIT SECRETS OR SERVICE_ROLE_KEY TO CLIENT REPOSITORIES

# Supabase Project URL (replace with your Supabase instance)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for client-side usage with RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Remote Filter Update Feed URL
REMOTE_FILTER_FEED_URL=https://your-project-id.supabase.co/functions/v1/remote_config

# Sentry / Bug Reporting DSN (Optional, privacy-preserving crash telemetry)
SENTRY_DSN=

# Environment mode: development, staging, production
ENVIRONMENT=development
